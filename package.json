{
  "name": "warframe-tier-list",
  "version": "2.0.0",
  "private": true,
  "description": "Guia brasileiro de Warframe com tier list, builds, farm, Incarnon e loadouts.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:security",
    "test:security": "node --experimental-strip-types --test scripts/security-storage.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:check": "npm run lint && npm run test:security && npm run build && npm run security:audit",
    "validate:migration": "node scripts/validate-migration.js",
    "db:schema": "node scripts/apply-schema.js",
    "deploy:check": "npm run validate:migration && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-slot": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "^15.5.18",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "latest",
    "tailwindcss-animate": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "8.5.14",
    "tailwindcss": "^3.4.17",
    "typescript": "latest"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
